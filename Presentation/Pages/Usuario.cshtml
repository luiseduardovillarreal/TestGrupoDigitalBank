@page
@model Presentacion.Pages.UsuarioModel
@{
    ViewData["Title"] = "Interfaz de usuario - Usuario";
}

<div class="container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    <form method="post">
        @Html.AntiForgeryToken()
        <div class="row mb-4">
            <div class="col-md-12">
                <label for="names" class="form-label">Nombres completos: <span class="red-span">*</span></label>
                <input type="text" id="names" name="names" class="form-control @(ViewData["namesError"] != null ? "is-invalid" : "")"
                    value="@ViewData["namesValue"]" aria-describedby="namesHelpBlock">
                <div class="invalid-feedback">
                    @ViewData["namesError"]
                </div>
                <div id="namesHelpBlock" class="form-text">
                    Digite sus nombres completos; nombres y apellidos.
                </div>
            </div>
        </div>
        <div class="row mb-4">
            <div class="col-md-6">
                <label for="dateOfBirth" class="form-label">Fecha de nacimiento: <span class="red-span">*</span></label>
                <input type="date" id="dateOfBirth" name="dateOfBirth" class="form-control @(ViewData["dateError"] != null ? "is-invalid" : "")"
                    value="@ViewData["dateValue"]" aria-describedby="dateOfBirthHelpBlock">
                <div class="invalid-feedback">
                    @ViewData["dateError"]
                </div>
                <div id="dateOfBirthHelpBlock" class="form-text">
                    Seleccione aquí su fecha de nacimiento.
                </div>
            </div>
            <div class="col-md-6">
                <label for="idGender" class="form-label">Sexo: <span class="red-span">*</span></label>
                <select id="idGender" name="idGender" class="form-select @(ViewData["sexError"] != null ? "is-invalid" : "")" asp-items="Model.Genders" aria-describedby="sexHelpBlock">
                    <option value="">Seleccione...</option>
                </select>
                <div class="invalid-feedback">
                    @ViewData["sexError"]
                </div>
                <div id="sexHelpBlock" class="form-text">
                    Seleccione aquí su sexualidad.
                </div>
            </div>
        </div>
        <hr />
        <div class="row mb-4">
            <div class="col-12 text-center">
                <button type="submit" asp-page-handler="SaveUser" class="btn btn-success">
                    Guardar
                </button>
            </div>
        </div>
    </form>
</div>