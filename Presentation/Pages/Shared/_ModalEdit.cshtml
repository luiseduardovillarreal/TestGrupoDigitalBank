@page
@model List<SelectListItem>
@{
}

<div class="modal fade" id="modalEdit" tabindex="-1" aria-labelledby="modalEditLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title" id="modalEditLabel">
                    <i class="bi bi-pencil-fill"></i> Editar usuario
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <form method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="editId" name="id" />
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="editNames" class="form-label">Nombres completos: <span class="red-span">*</span></label>
                            <input type="text" id="editNames" name="names" class="form-control" required />
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label for="editDateOfBirth" class="form-label">Fecha de nacimiento: <span class="red-span">*</span></label>
                            <input type="date" id="editDateOfBirth" name="dateOfBirth" class="form-control" required />
                        </div>
                        <div class="col-md-6">
                            <label for="editIdGender" class="form-label">Sexo: <span class="red-span">*</span></label>
                            <select id="editIdGender" name="idGender" class="form-select" asp-items="Model" required>
                                <option value="">Seleccione...</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="bi bi-x-circle"></i> Cancelar
                    </button>
                    <button type="submit" asp-page-handler="UpdateUser" class="btn btn-warning">
                        <i class="bi bi-save"></i> Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>